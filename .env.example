# Temporary demo linking; set false to require the existing Firebase login.
DEMO_AUTH_MODE=true

# Required for authenticated dashboard handoffs. Use a 32+ character secret
# shared with the service that creates the signed __Host-tany-dashboard cookie.
MESSAGING_SERVICE_SECRET=

# Phone OTP login uses a separate HMAC secret; do not reuse a client-visible key.
TANY_PHONE_LOGIN_SECRET=
# Server-side Twilio SMS delivery for phone login.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Local URL used by `npm run dev:admin-session`; keep this localhost-only.
TANY_MESSAGING_LOCAL_ORIGIN=http://localhost:3000

# Firebase Admin uses Application Default Credentials. For local development,
# either run `gcloud auth application-default login` or point this to a mounted,
# uncommitted service-account JSON file for the tany-whatsapp project.
GOOGLE_APPLICATION_CREDENTIALS=

# Phase 1 data migration. Existing environments remain Firestore-authoritative.
MESSAGING_DATABASE=firestore
# PostgreSQL integration is opt-in. `dual-write` keeps Firestore authoritative
# and mirrors safe persistence only; never put Meta token values in either env map.
# MESSAGING_DATABASE=dual-write
DATABASE_URL=
# Required by the migration/seed safeguards; use `staging` only on the staging branch.
MESSAGING_POSTGRES_TARGET=
# Standalone Postgres tenant rows are resolved by messaging_businesses.legacy_business_id.
# No dealer map or external TanyApps database is required.

# Server-side manual test activation; keep false for normal live deployments.
WHATSAPP_SETUP_ALLOW_MANUAL_TEST=false
# Enable real Meta validation only after secret references are mounted.
WHATSAPP_SETUP_LIVE_TESTS=false
# Comma-separated names of mounted secret environment variables (never their values).
WHATSAPP_TOKEN_SECRET_NAMES=
# Approved test recipients, international digits, comma-separated.
WHATSAPP_SETUP_TEST_RECIPIENTS=

# Bind each business to its mounted secret name, e.g. {"demo-eats":"TANY_EATS_TOKEN"}
WHATSAPP_TOKEN_SECRET_BINDINGS={}
# Meta Embedded Signup (staging deploy values; raw app secret remains server-only).
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v27.0
# Optional explicit project override; otherwise the server uses GOOGLE_CLOUD_PROJECT.
WHATSAPP_TOKEN_SECRET_PROJECT=

# Product workspace destination; contains no service credential.
TANY_PRODUCT_DASHBOARD_URL=https://app.tany.in/dashboard

# Server-only shared secret (32+ characters) for the scheduled automation worker.
AUTOMATION_WORKER_SECRET=

# Disabled: send native single-product cards until Meta product-list support is retried.
WHATSAPP_PRODUCT_LIST_ENABLED=false

